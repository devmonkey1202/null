{
  "name": "null",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--require=./scripts/async-local-storage-global.cjs npx tsx server.ts",
    "dev:e2e": "cross-env NODE_OPTIONS=--require=./scripts/async-local-storage-global.cjs NEXT_PUBLIC_E2E=1 NULL_NEXT_DIST_DIR=.next-e2e PORT=3101 PLAYWRIGHT_TEST_PORT=3101 PLAYWRIGHT_TEST_BASE_URL=http://127.0.0.1:3101 npx tsx server.ts",
    "build": "prisma generate && next build",
    "start": "cross-env NODE_OPTIONS=--require=./scripts/async-local-storage-global.cjs RUN_MODE=prod NODE_ENV=production npx tsx server.ts",
    "start:build": "npm run build && npm run start",
    "clean": "rimraf .next",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "verify:prisma": "prisma validate",
    "verify:types": "tsc --noEmit --pretty false",
    "verify:mobile": "npx tsx scripts/verify-mobile-hosts.ts",
    "verify:unit": "vitest run",
    "verify:e2e": "playwright test --workers=1",
    "verify:build": "npm run build",
    "verify:full": "npm run verify:prisma && npm run verify:types && npm run lint && npm run verify:mobile && npm run verify:unit && npm run verify:build && npm run verify:e2e",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "mobile:cap:prepare": "npx tsx scripts/mobile/prepare-capacitor.ts",
    "mobile:rn:prepare": "npx tsx scripts/mobile/prepare-react-native.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.6.1",
    "jsdom": "^28.1.0",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "martinez-polygon-clipping": "^0.8.1",
    "next": "16.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^17.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^20",
    "@types/react": "19.2.8",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "prisma": "^6.9.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
