// Prisma schema for NULL
// Acceptance criteria (Step 1):
// - Core models and enums are defined for User, Plan, Page, PageVersion, LiveSession, Event, GhostTrace, Report, Upvote, ReportAbuse, AdminUser.
// - Schema supports live/expired workflow and base moderation fields.
//
// Step 7 (Abuse & Admin) extensions (PART 1):
// - Report handling metadata (admin action, handled_by, handled_at)
// - Page moderation metadata (hidden/forced-expire)
// - AdminSession for secure admin auth
// - IpBlock to support simple abuse mitigation
//
// IMPORTANT:


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  free
  standard
  pro
  enterprise
}

enum PageStatus {
  draft
  live
  expired
}

enum EventType {
  enter
  leave
  move
  click
  scroll
  error
  custom
}

enum ReportStatus {
  open
  resolved
  dismissed
}

enum ReportAction {
  none
  hide_page
  force_expire
  suspend_owner
  ban_ip
}

enum AdminRole {
  owner
  staff
  viewer
}

enum OrgMemberRole {
  owner
  admin
  member
  viewer
}

enum OrgMemberStatus {
  invited
  active
  removed
}

enum TeamMemberRole {
  lead
  member
}

enum BackgroundJobStatus {
  queued
  running
  succeeded
  failed
  dead_lettered
}

enum AppSsoProvider {
  oauth
  saml
}

model Plan {
  id          PlanTier @id
  name        String
  price_cents Int?
  features    Json
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  users       User[]
}

model User {
  id           String   @id @default(cuid())
  anon_id      String   @unique
  email        String?  @unique
  password_hash String?
  email_verified_at DateTime?
  last_login_at DateTime?
  plan_id      PlanTier @default(free)
  plan         Plan     @relation(fields: [plan_id], references: [id])
  is_suspended Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  pages        Page[]
  sessions     LiveSession[]
  upvotes      Upvote[]
  reports      Report[]
  comments     Comment[]
  app_record_versions AppRecordVersion[] @relation("AppRecordVersionActorUser")
  app_workflow_versions AppWorkflowVersion[] @relation("AppWorkflowVersionActorUser")
  app_audit_logs AppAuditLog[] @relation("AppAuditActorUser")
  page_audit_logs PageAuditLog[] @relation("PageAuditActorUser")
  owned_orgs Organization[] @relation("OrgOwner")
  org_members OrganizationMember[]
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  owner_id   String
  owner      User     @relation("OrgOwner", fields: [owner_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members OrganizationMember[]
  teams   Team[]
  pages   Page[]

  @@index([owner_id])
}

model OrganizationMember {
  id         String           @id @default(cuid())
  org_id     String
  org        Organization     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user_id    String?
  user       User?            @relation(fields: [user_id], references: [id])
  email      String?
  role       OrgMemberRole    @default(member)
  status     OrgMemberStatus  @default(invited)
  invited_at DateTime         @default(now())
  joined_at  DateTime?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  teams TeamMember[]

  @@unique([org_id, user_id])
  @@unique([org_id, email])
  @@index([org_id, status])
}

model Team {
  id         String   @id @default(cuid())
  org_id     String
  org        Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  name       String
  slug       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  members TeamMember[]

  @@unique([org_id, slug])
  @@index([org_id])
}

model TeamMember {
  id            String         @id @default(cuid())
  team_id       String
  team          Team           @relation(fields: [team_id], references: [id], onDelete: Cascade)
  org_member_id String
  org_member    OrganizationMember @relation(fields: [org_member_id], references: [id], onDelete: Cascade)
  role          TeamMemberRole @default(member)
  created_at    DateTime       @default(now())

  @@unique([team_id, org_member_id])
}

model Page {
  id                  String       @id @default(cuid())
  owner_id            String
  owner               User         @relation(fields: [owner_id], references: [id])
  org_id              String?
  org                 Organization? @relation(fields: [org_id], references: [id])
  title               String?
  anon_number         Int
  status              PageStatus   @default(draft)
  live_started_at     DateTime?
  live_expires_at     DateTime?
  deployed_at         DateTime?
  scheduled_report_enabled Boolean @default(false)
  auto_drop_alert      Boolean    @default(false)
  discord_webhook_url  String?
  snapshot_thumbnail  String?
  constraints_version String       @default("v1")
  current_version_id  String?      @unique
  current_version     PageVersion? @relation("CurrentPageVersion", fields: [current_version_id], references: [id])
  collab_invite_code  String?      @unique
  collab_invite_enabled Boolean    @default(false)
  collab_invite_updated_at DateTime?

  // Aggregated metrics (lightweight)
  total_visits      Int   @default(0)
  unique_sessions   Int   @default(0)
  total_clicks      Int   @default(0)
  total_duration_ms Int   @default(0)
  avg_duration_ms   Float @default(0)
  bounce_count      Int   @default(0)
  bounce_rate       Float @default(0)
  upvote_count      Int   @default(0)
  report_count      Int   @default(0)
  abuse_score       Float @default(0)

  // Moderation
  is_hidden  Boolean @default(false)
  is_deleted Boolean @default(false)

  hidden_at           DateTime?
  hidden_reason       String?
  hidden_by_admin_id  String?
  hidden_by_admin     AdminUser? @relation("PageHiddenBy", fields: [hidden_by_admin_id], references: [id])

  forced_expired_at   DateTime?
  forced_by_admin_id  String?
  forced_by_admin     AdminUser? @relation("PageForcedBy", fields: [forced_by_admin_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  versions     PageVersion[] @relation("PageVersions")
  sessions     LiveSession[]
  events       Event[]
  upvotes      Upvote[]
  reports      Report[]
  ghost_traces GhostTrace[]
  comments     Comment[]
  app_collections AppCollection[]
  app_records    AppRecord[]
  daily_stats   DailyPageStats[]
  segments      Segment[]

  app_sessions    AppSession[]
  app_users       AppUser[]
  app_secrets     AppSecret[]
  app_workflows   AppWorkflow[]
  app_record_versions AppRecordVersion[]
  app_workflow_versions AppWorkflowVersion[]
  app_audit_logs AppAuditLog[]
  page_audit_logs PageAuditLog[]
  sso_connections AppSsoConnection[]
  sso_accounts    AppSsoAccount[]

  chat_messages   ChatMessage[]
  todos           Todo[]
  calendar_events CalendarEvent[]
  kanban_columns  KanbanColumn[]
  kanban_cards    KanbanCard[]
  note            Note?
  page_settings   PageSetting[]
  page_domains    PageDomain[]
  page_notifications PageNotification[]
  call_states      CallState[]
  background_jobs  BackgroundJob[]
  service_events   ServiceEvent[]
  service_state_machines ServiceStateMachine[]
  service_state_instances ServiceStateInstance[]
  service_state_transitions ServiceStateTransition[]
  service_realtime_channels ServiceRealtimeChannel[]
  service_realtime_messages ServiceRealtimeMessage[]
  service_realtime_presences ServiceRealtimePresence[]
  service_realtime_receipts ServiceRealtimeReceipt[]
  service_search_indices ServiceSearchIndex[]
  service_search_documents ServiceSearchDocument[]
  service_ranking_rules ServiceRankingRule[]
  service_ranking_snapshots ServiceRankingSnapshot[]
  service_notifications ServiceNotification[]
  service_notification_deliveries ServiceNotificationDelivery[]
  service_notification_preferences ServiceNotificationPreference[]
  service_media_assets ServiceMediaAsset[]
  service_media_variants ServiceMediaVariant[]
  service_media_upload_sessions ServiceMediaUploadSession[]
  service_billing_accounts ServiceBillingAccount[]
  service_billing_plans ServiceBillingPlan[]
  service_billing_subscriptions ServiceBillingSubscription[]
  service_billing_usage_records ServiceBillingUsageRecord[]
  service_billing_charges ServiceBillingCharge[]
  service_billing_invoices ServiceBillingInvoice[]
  service_billing_invoice_lines ServiceBillingInvoiceLine[]
  service_billing_settlements ServiceBillingSettlement[]
  service_policy_rules ServicePolicyRule[]
  service_policy_approval_requests ServicePolicyApprovalRequest[]
  service_policy_overrides ServicePolicyOverride[]
  service_risk_incidents ServiceRiskIncident[]
  service_risk_sanctions ServiceRiskSanction[]
  service_geo_places ServiceGeoPlace[]
  service_geo_regions ServiceGeoRegion[]
  service_geo_route_caches ServiceGeoRouteCache[]
  service_runtime_modules ServiceRuntimeModule[]
  service_runtime_functions ServiceRuntimeFunction[]

  @@index([owner_id, status])
  @@index([status, live_expires_at])
  @@index([org_id])
}

model BackgroundJob {
  id           String             @id @default(cuid())
  page_id      String?
  page         Page?              @relation(fields: [page_id], references: [id], onDelete: SetNull)
  queue        String             @default("default")
  type         String
  payload      Json?
  dedupe_key   String?
  status       BackgroundJobStatus @default(queued)
  run_at       DateTime           @default(now())
  priority     Int                @default(100)
  locked_at    DateTime?
  locked_by    String?
  attempts     Int                @default(0)
  max_attempts Int                @default(3)
  last_error   String?
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  finished_at  DateTime?

  @@unique([page_id, queue, dedupe_key])
  @@index([queue, status, priority, run_at])
  @@index([status, run_at])
  @@index([page_id])
}

model BackgroundJobDeadLetter {
  id           String   @id @default(cuid())
  job_id       String
  page_id      String?
  queue        String   @default("default")
  type         String
  payload      Json?
  attempts     Int
  max_attempts Int
  last_error   String?
  failed_at    DateTime @default(now())
  metadata     Json?
  created_at   DateTime @default(now())

  @@unique([job_id])
  @@index([queue, failed_at])
  @@index([page_id, queue, failed_at])
}

model ServiceRuntimeModule {
  id         String   @id @default(cuid())
  page_id    String
  page       Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key        String
  name       String
  kind       String   @default("generic")
  enabled    Boolean  @default(true)
  sandbox    Json?
  metadata   Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  functions  ServiceRuntimeFunction[]

  @@unique([page_id, key])
  @@index([page_id, kind, enabled])
}

model ServiceRuntimeFunction {
  id           String   @id @default(cuid())
  page_id      String
  page         Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  module_id    String?
  module       ServiceRuntimeModule? @relation(fields: [module_id], references: [id], onDelete: SetNull)
  key          String
  name         String
  target       String   @default("generic")
  enabled      Boolean  @default(true)
  code         String
  timeout_ms   Int      @default(10000)
  memory_mb    Int      @default(128)
  network_mode String   @default("inherit")
  network_allow Json?
  network_deny  Json?
  secret_keys   Json?
  metadata      Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([page_id, key])
  @@index([page_id, target, enabled])
  @@index([module_id])
}

model ServiceEvent {
  id                 String   @id @default(cuid())
  page_id            String
  page               Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  stream             String
  topic              String
  event_key          String?
  type               String
  entity_type        String?
  entity_id          String?
  source             String?
  payload            Json?
  meta               Json?
  status             String   @default("published") // "published" | "processed" | "dead_letter" | "compensated"
  attempts           Int      @default(0)
  max_attempts       Int      @default(3)
  available_at       DateTime @default(now())
  published_at       DateTime @default(now())
  processed_at       DateTime?
  dead_lettered_at   DateTime?
  compensation_of_id String?
  compensation_of    ServiceEvent? @relation("ServiceEventCompensations", fields: [compensation_of_id], references: [id], onDelete: SetNull)
  compensations      ServiceEvent[] @relation("ServiceEventCompensations")
  transitions        ServiceStateTransition[]
  instances          ServiceStateInstance[] @relation("ServiceEventLastInstance")

  @@unique([page_id, stream, event_key])
  @@index([page_id, stream, published_at])
  @@index([page_id, topic, published_at])
  @@index([page_id, entity_type, entity_id, published_at])
  @@index([page_id, status, available_at])
}

model ServiceStateMachine {
  id          String   @id @default(cuid())
  page_id     String
  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key         String
  name        String
  version     Int      @default(1)
  definition  Json
  enabled     Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  instances   ServiceStateInstance[]
  transitions ServiceStateTransition[]

  @@unique([page_id, key])
  @@index([page_id, enabled])
}

model ServiceStateInstance {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  machine_id    String
  machine       ServiceStateMachine @relation(fields: [machine_id], references: [id], onDelete: Cascade)
  entity_type   String
  entity_id     String
  current_state String
  data          Json?
  version       Int      @default(0)
  last_event_id String?
  last_event    ServiceEvent? @relation("ServiceEventLastInstance", fields: [last_event_id], references: [id], onDelete: SetNull)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  transitions   ServiceStateTransition[]

  @@unique([machine_id, entity_type, entity_id])
  @@index([page_id, entity_type, entity_id])
}

model ServiceStateTransition {
  id             String   @id @default(cuid())
  page_id        String
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  machine_id     String
  machine        ServiceStateMachine @relation(fields: [machine_id], references: [id], onDelete: Cascade)
  instance_id    String
  instance       ServiceStateInstance @relation(fields: [instance_id], references: [id], onDelete: Cascade)
  event_id       String?
  event          ServiceEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)
  transition_key String
  from_state     String?
  to_state       String
  status         String   @default("applied") // "applied" | "rejected" | "compensated"
  reason         String?
  payload        Json?
  created_at     DateTime @default(now())

  @@index([page_id, created_at])
  @@index([machine_id, instance_id, created_at])
}

model ServiceRealtimeChannel {
  id             String   @id @default(cuid())
  page_id        String
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key            String
  topic          String
  kind           String   @default("generic")
  config         Json?
  message_limit  Int      @default(100)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  messages       ServiceRealtimeMessage[]
  presences      ServiceRealtimePresence[]
  receipts       ServiceRealtimeReceipt[]

  @@unique([page_id, key])
  @@index([page_id, topic])
}

model ServiceRealtimeMessage {
  id             String   @id @default(cuid())
  page_id        String
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  channel_id     String
  channel        ServiceRealtimeChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  message_key    String?
  type           String   @default("message")
  sender_key     String
  sender_name    String?
  body           Json?
  meta           Json?
  created_at     DateTime @default(now())

  receipts       ServiceRealtimeReceipt[]

  @@index([page_id, created_at])
  @@index([channel_id, created_at])
  @@index([channel_id, sender_key, message_key])
}

model ServiceRealtimePresence {
  id             String   @id @default(cuid())
  page_id        String
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  channel_id     String
  channel        ServiceRealtimeChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  connection_key String
  member_key     String
  session_id     String?
  socket_id      String?
  name           String?
  status         String   @default("online")
  meta           Json?
  joined_at      DateTime @default(now())
  last_seen_at   DateTime @default(now())

  @@unique([channel_id, connection_key])
  @@index([page_id, member_key])
  @@index([channel_id, last_seen_at])
}

model ServiceRealtimeReceipt {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  channel_id    String
  channel       ServiceRealtimeChannel @relation(fields: [channel_id], references: [id], onDelete: Cascade)
  message_id    String
  message       ServiceRealtimeMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  recipient_key String
  delivered_at  DateTime?
  read_at       DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([message_id, recipient_key])
  @@index([page_id, recipient_key])
  @@index([channel_id, updated_at])
}

model ServiceSearchIndex {
  id           String   @id @default(cuid())
  page_id      String
  page         Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key          String
  name         String
  source_type  String
  source_key   String
  title_fields Json?
  body_fields  Json?
  facet_fields Json?
  sort_field   String?
  visibility   String   @default("owner")
  scope_mode   String   @default("all")
  enabled      Boolean  @default(true)
  config       Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  documents    ServiceSearchDocument[]

  @@unique([page_id, key])
  @@index([page_id, source_type, source_key])
}

model ServiceSearchDocument {
  id          String   @id @default(cuid())
  page_id     String
  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  index_id    String
  index       ServiceSearchIndex @relation(fields: [index_id], references: [id], onDelete: Cascade)
  source_type String
  source_key  String
  source_id   String
  title       String?
  body        String
  facets      Json?
  sort_text   String?
  sort_number Float?
  sort_date   DateTime?
  app_user_id String?
  payload     Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([index_id, source_id])
  @@index([page_id, index_id])
  @@index([page_id, source_type, source_key])
  @@index([page_id, app_user_id])
  @@index([page_id, updated_at])
}

model ServiceRankingRule {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key           String
  name          String
  source_type   String
  source_key    String
  title_fields  Json?
  excerpt_fields Json?
  facet_fields  Json?
  visibility    String   @default("owner")
  scope_mode    String   @default("all")
  enabled       Boolean  @default(true)
  config        Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  snapshots     ServiceRankingSnapshot[]

  @@unique([page_id, key])
  @@index([page_id, source_type, source_key])
}

model ServiceRankingSnapshot {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  rule_id       String
  rule          ServiceRankingRule @relation(fields: [rule_id], references: [id], onDelete: Cascade)
  source_type   String
  source_key    String
  source_id     String
  title         String?
  excerpt       String?
  score         Float
  rank          Int?
  facets        Json?
  app_user_id   String?
  payload       Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([rule_id, source_id])
  @@index([page_id, rule_id])
  @@index([page_id, source_type, source_key])
  @@index([page_id, app_user_id])
  @@index([page_id, score, updated_at])
}

model ServiceNotification {
  id                 String   @id @default(cuid())
  page_id            String
  page               Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  recipient_key      String
  recipient_label    String?
  app_user_id        String?
  type               String   @default("generic")
  topic              String   @default("general")
  title              String?
  body               String?
  payload            Json?
  delivery_channels  Json?
  source_type        String?
  source_id          String?
  status             String   @default("queued")
  scheduled_for      DateTime @default(now())
  sent_at            DateTime?
  read_at            DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  deliveries         ServiceNotificationDelivery[]

  @@index([page_id, recipient_key, read_at, created_at])
  @@index([page_id, status, scheduled_for])
  @@index([page_id, topic, created_at])
}

model ServiceNotificationDelivery {
  id               String   @id @default(cuid())
  page_id          String
  page             Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  notification_id  String
  notification     ServiceNotification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  channel          String
  provider         String?
  status           String   @default("queued")
  error            String?
  meta             Json?
  delivered_at     DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([page_id, channel, status, created_at])
  @@index([notification_id, channel])
}

model ServiceNotificationPreference {
  id               String   @id @default(cuid())
  page_id          String
  page             Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  recipient_key    String
  channel          String
  topic            String
  enabled          Boolean  @default(true)
  muted_until      DateTime?
  config           Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@unique([page_id, recipient_key, channel, topic])
  @@index([page_id, recipient_key, channel])
}

model ServiceMediaAsset {
  id                   String   @id @default(cuid())
  page_id              String
  page                 Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key                  String
  original_name        String
  kind                 String
  mime_type            String
  backend              String
  storage_scope        String   @default("private")
  storage_key          String
  public_url           String?
  visibility           String   @default("signed")
  status               String   @default("processing")
  size_bytes           Int
  checksum_sha256      String?
  width                Int?
  height               Int?
  duration_ms          Int?
  placeholder_data_url String?
  metadata             Json?
  processed_at         DateTime?
  last_error           String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  variants ServiceMediaVariant[]

  @@unique([page_id, key])
  @@index([page_id, kind, created_at])
  @@index([page_id, status, created_at])
}

model ServiceMediaVariant {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  asset_id      String
  asset         ServiceMediaAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  key           String
  name          String
  mime_type     String
  backend       String
  storage_scope String   @default("private")
  storage_key   String
  public_url    String?
  size_bytes    Int
  width         Int?
  height        Int?
  metadata      Json?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([asset_id, name])
  @@unique([page_id, key])
  @@index([page_id, asset_id])
}

model ServiceMediaUploadSession {
