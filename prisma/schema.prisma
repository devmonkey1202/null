  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  app_user_id String
  app_user    AppUser  @relation(fields: [app_user_id], references: [id], onDelete: Cascade)
  token       String   @unique
  expires_at  DateTime
  created_at  DateTime @default(now())

  @@index([token])
  @@index([app_user_id])
}

model AppSsoConnection {
  id          String          @id @default(cuid())
  page_id     String
  page        Page            @relation(fields: [page_id], references: [id], onDelete: Cascade)
  provider    AppSsoProvider
  name        String
  enabled     Boolean         @default(true)
  issuer      String?
  client_id   String?
  client_secret String?
  authorization_url String?
  token_url   String?
  metadata_url String?
  certificate_pem String?
  entity_id   String?
  acs_url     String?
  sign_requests Boolean       @default(false)
  auto_provision Boolean      @default(false)
  allow_unlinked Boolean      @default(false)
  default_role String?
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  accounts    AppSsoAccount[]

  @@unique([page_id, provider, name])
  @@index([page_id, provider])
}

model AppSsoAccount {
  id           String          @id @default(cuid())
  page_id      String
  page         Page            @relation(fields: [page_id], references: [id], onDelete: Cascade)
  connection_id String
  connection   AppSsoConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  app_user_id  String
  app_user     AppUser         @relation(fields: [app_user_id], references: [id], onDelete: Cascade)
  provider     AppSsoProvider
  subject      String
  email        String?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt

  @@unique([connection_id, subject])
  @@index([page_id, app_user_id])
  @@index([page_id, provider])
}

model AppSecret {
  id        String   @id @default(cuid())
  page_id   String
  page      Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key       String
  value     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([page_id, key])
  @@index([page_id])
}

model AppWorkflow {
  id         String   @id @default(cuid())
  page_id    String
  page       Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  name       String
  trigger    Json     // WorkflowTrigger
  steps      Json     // WorkflowStep[]
  enabled    Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([page_id])
}

model AppWorkflowVersion {
  id              String   @id @default(cuid())
  page_id         String
  page            Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  workflow_id     String
  name            String
  trigger         Json
  steps           Json
  enabled         Boolean
  version         Int
  actor_user_id   String?
  actor_user      User?    @relation("AppWorkflowVersionActorUser", fields: [actor_user_id], references: [id])
  actor_app_user_id String?
  actor_app_user  AppUser? @relation("AppWorkflowVersionActorAppUser", fields: [actor_app_user_id], references: [id])
  actor_anon_id   String?
  created_at      DateTime @default(now())

  @@index([page_id, workflow_id, version])
  @@index([page_id, created_at])
  @@index([actor_user_id])
  @@index([actor_app_user_id])
}

model AppAuditLog {
  id                String   @id @default(cuid())
  page_id           String
  page              Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  action            String
  target_type       String?
  target_id         String?
  actor_user_id     String?
  actor_user        User?    @relation("AppAuditActorUser", fields: [actor_user_id], references: [id])
  actor_app_user_id String?
  actor_app_user    AppUser? @relation("AppAuditActorAppUser", fields: [actor_app_user_id], references: [id])
  actor_anon_id     String?
  meta              Json?
  created_at        DateTime @default(now())

  @@index([page_id, created_at])
  @@index([action, created_at])
  @@index([actor_user_id])
  @@index([actor_app_user_id])
}

model PageAuditLog {
  id            String   @id @default(cuid())
  page_id       String
  page          Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  action        String
  target_type   String?
  target_id     String?
  actor_user_id String?
  actor_user    User?    @relation("PageAuditActorUser", fields: [actor_user_id], references: [id])
  actor_anon_id String?
  meta          Json?
  created_at    DateTime @default(now())

  @@index([page_id, created_at])
  @@index([action, created_at])
  @@index([actor_user_id])
}

model AppWorkflowLog {
  id          String   @id @default(cuid())
  workflow_id String
  page_id     String
  status      String   // "success" | "error" | "running"
  input       Json?
  output      Json?
  error       String?
  started_at  DateTime @default(now())
  finished_at DateTime?

  @@index([workflow_id])
  @@index([page_id])
}

model ChatMessage {
  id             String   @id @default(cuid())
  page_id        String
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  sender_user_id String?
  sender_anon_id String?
  content        String
  created_at     DateTime @default(now())

  @@index([page_id, created_at])
}

model Todo {
  id         String   @id @default(cuid())
  page_id    String
  page       Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  title      String
  done       Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([page_id, sort_order])
}

model CalendarEvent {
  id         String    @id @default(cuid())
  page_id    String
  page       Page      @relation(fields: [page_id], references: [id], onDelete: Cascade)
  title      String
  start_at   DateTime
  end_at     DateTime?
  all_day    Boolean   @default(false)
  meta       Json?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([page_id, start_at])
}

model KanbanColumn {
  id         String       @id @default(cuid())
  page_id    String
  page       Page         @relation(fields: [page_id], references: [id], onDelete: Cascade)
  title      String
  sort_order Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  cards      KanbanCard[]

  @@index([page_id, sort_order])
}

model KanbanCard {
  id         String        @id @default(cuid())
  page_id    String
  page       Page          @relation(fields: [page_id], references: [id], onDelete: Cascade)
  column_id  String
  column     KanbanColumn  @relation(fields: [column_id], references: [id], onDelete: Cascade)
  title      String
  body       String?
  sort_order Int           @default(0)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  @@index([page_id, column_id, sort_order])
}

model Note {
  id             String   @id @default(cuid())
  page_id        String   @unique
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  author_user_id String?
  author_anon_id String?
  content        String   @default("")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([page_id])
}

model PageSetting {
  id        String   @id @default(cuid())
  page_id   String
  page      Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updated_at DateTime @default(now()) @updatedAt

  @@unique([page_id, key])
  @@index([page_id])
}

model PageDomain {
  id              String   @id @default(cuid())
  page_id         String
  page            Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  domain          String   @unique
  status          String   @default("pending")
  verified_at     DateTime?
  force_https     Boolean  @default(false)
  redirect_www    Boolean  @default(false)
  last_checked_at DateTime?
  last_error      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@index([page_id])
}

model PageNotification {
  id          String    @id @default(cuid())
  page_id     String
  page        Page      @relation(fields: [page_id], references: [id], onDelete: Cascade)
  recipient_user_id String?
  recipient_anon_id String?
  type        String    // mention, comment_reply, chat_mention, etc.
  ref_id      String?   // comment_id, chat_message_id
  title       String?
  body        String?
  read_at     DateTime?
  created_at  DateTime  @default(now())

  @@index([page_id, recipient_user_id, read_at])
  @@index([page_id, recipient_anon_id, read_at])
}

model CallState {
  id           String   @id @default(cuid())
  page_id      String
  page         Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  participant_id String  // anon_id or user_id
  status       String   // idle, ringing, in_call, ended
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([page_id, participant_id])
  @@index([page_id])
}


